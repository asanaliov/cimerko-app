@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-single">
    <section class="login-card">
        <div class="login-heading">
            <h1>Forgot your password?</h1>
            <p>Enter the email you signed up with and we will send you a link to choose a new one.</p>
        </div>

        @if (Model.EmailSent) {
            <div class="alert alert-success" role="status">
                If an account exists for that email, a reset link is on its way. Check your inbox and spam folder.
            </div>
        } else {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="login-validation-summary" role="alert"></div>
                <div class="login-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="username"
                           inputmode="email"
                           placeholder="you@example.com"
                           autofocus/>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn login-submit">Send reset link</button>
            </form>
        }

        <p class="login-register">
            Remembered it? <a asp-page="./Login">Back to log in</a>
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

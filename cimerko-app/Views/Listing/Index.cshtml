@model cimerko_app.Models.ViewModels.ListingIndexViewModel
@using cimerko_app.Models.ViewModels

@{
    ViewData["Title"] = "Listings";
    var currentUserId = ViewBag.CurrentUserId as string;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var saveUrl = Url.Action("Save", "SavedListing");
    var removeUrl = Url.Action("Remove", "SavedListing");
    var mapLocation = string.IsNullOrWhiteSpace(Model.City)
        ? "Skopje, North Macedonia"
        : Model.City.Trim();
    var mapQuery = Uri.EscapeDataString(mapLocation);
    var googleMapsUrl = $"https://www.google.com/maps/search/?api=1&query={mapQuery}";
    var googleMapsEmbedUrl = $"https://www.google.com/maps?q={mapQuery}&z=12&output=embed";
    var isRentalSearch = Model.Type == ListingType.PlaceForRent;
    var isRoommateSearch = Model.Type == ListingType.LookingForRoommate;
}

<div class="page-shell">
    <section class="listing-discovery">
        <div class="listing-discovery-main">
            <header class="listing-page-header">
                <div>
                    <h1 class="listing-page-title">Find your perfect place</h1>
                    <p class="listing-page-intro">Quality student housing, verified and tailored for you.</p>
                </div>

                @if (User.Identity?.IsAuthenticated == true) {
                    <a asp-action="Create" class="btn-cimerko-primary listing-create-button">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        Create listing
                    </a>
                }
            </header>

    <form asp-action="Index" method="get" class="listing-discovery-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
        @if (Model.Type.HasValue) {
            <input asp-for="Type" type="hidden"/>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Sort)) {
            <input asp-for="Sort" type="hidden"/>
        }

        <div class="listing-search-custom">
            <div class="search-input-group">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--cm-muted)" stroke-width="2.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <input asp-for="City" placeholder="City or neighbourhood" aria-label="City or neighbourhood" />
            </div>

            <div class="search-input-group">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--cm-muted)" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input asp-for="Title" placeholder="Keyword, e.g. balcony or studio" aria-label="Keyword" />
            </div>

            <button type="submit" class="btn-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                Search
            </button>
        </div>

        <details class="listing-filters" data-listing-filters>
            <summary class="filters-toggle-summary">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
                Filters
                @if (Model.AdvancedFilterCount > 0) {
                    <span class="filters-toggle-count">@Model.AdvancedFilterCount</span>
                }
                <svg class="filters-toggle-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>

            <div class="listing-filters-panel" role="dialog" aria-label="Listing filters">
                <div class="listing-filters-head">
                    <strong>
                        @(isRentalSearch ? "Filter places for rent" : isRoommateSearch ? "Filter roommate listings" : "Filter listings")
                    </strong>
                    <button type="button" class="listing-filters-close" data-filters-close aria-label="Close filters">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>

                <div class="listing-filters-body">
                    <div class="listing-filters-grid">
                        <div class="listing-filters-field listing-filters-field-wide">
                            <label for="MinimumBudget">Budget per month</label>
                            <div class="listing-filters-range">
                                <input asp-for="MinimumBudget" type="number" min="0" step="1" placeholder="Min" aria-label="Minimum budget"/>
                                <em>–</em>
                                <input asp-for="MaximumBudget" type="number" min="0" step="1" placeholder="Max" aria-label="Maximum budget"/>
                                <em>€</em>
                            </div>
                            <span asp-validation-for="MaximumBudget" class="listing-form-error"></span>
                        </div>
                        @if (!Model.Type.HasValue) {
                            <div class="listing-filters-field listing-filters-field-wide">
                                <label asp-for="Type">Listing type</label>
                                <select asp-for="Type" asp-items="Html.GetEnumSelectList<ListingType>()">
                                    <option value="">Any type</option>
                                </select>
                            </div>
                        }
                        @if (isRentalSearch || isRoommateSearch) {
                            <div class="listing-filters-field">
                                <label asp-for="BedroomCount"></label>
                                <input asp-for="BedroomCount" type="number" min="0" max="20" placeholder="Any"/>
                            </div>
                        }
                        @if (isRentalSearch) {
                            <div class="listing-filters-field">
                                <label asp-for="TenantTypePreference"></label>
                                <select asp-for="TenantTypePreference" asp-items="Html.GetEnumSelectList<TenantTypePreference>()">
                                    <option value="">Any</option>
                                </select>
                            </div>
                            <div class="listing-filters-field">
                                <label asp-for="RentalSmokingPolicy"></label>
                                <select asp-for="RentalSmokingPolicy" asp-items="Html.GetEnumSelectList<RentalSmokingPolicy>()">
                                    <option value="">Any</option>
                                </select>
                            </div>
                            <div class="listing-filters-field">
                                <label asp-for="RentalPetPolicy"></label>
                                <select asp-for="RentalPetPolicy" asp-items="Html.GetEnumSelectList<RentalPetPolicy>()">
                                    <option value="">Any</option>
                                </select>
                            </div>
                        }
                        else if (isRoommateSearch) {
                            <div class="listing-filters-field">
                                <label asp-for="RoommateGenderPreference"></label>
                                <select asp-for="RoommateGenderPreference" asp-items="Html.GetEnumSelectList<RoommateGenderPreference>()">
                                    <option value="">Any</option>
                                </select>
                            </div>
                            <div class="listing-filters-field">
                                <label asp-for="RoommateHousingPlan"></label>
                                <select asp-for="RoommateHousingPlan" asp-items="Html.GetEnumSelectList<RoommateHousingPlan>()">
                                    <option value="">Any</option>
                                </select>
                            </div>
                        }
                    </div>

                    <div class="filter-chips">
                        <label><input asp-for="AvailableNow"/><span>Available now</span></label>
                        <label><input asp-for="HasImages"/><span>Has photos</span></label>
                        @if (isRoommateSearch) {
                            <label><input asp-for="RoommatePetFriendly"/><span>Pet-friendly</span></label>
                            <label><input asp-for="RoommateSmokeFree"/><span>Smoke-free</span></label>
                            <label><input asp-for="RoommateTidy"/><span>Tidy</span></label>
                            <label><input asp-for="RoommateGuestsWelcome"/><span>Guests welcome</span></label>
                            <label><input asp-for="RoommateEarlyBird"/><span>Early-bird routine</span></label>
                            <label><input asp-for="RoommateNightOwl"/><span>Night-owl routine</span></label>
                        }
                    </div>
                </div>

                <div class="listing-filters-foot">
                    @if (Model.HasActiveFilters) {
                        <a asp-action="Index" asp-route-Type="@Model.Type" class="listing-filters-clear">Clear all</a>
                    }
                    <button type="submit" class="btn-cimerko-primary listing-filters-apply">Show results</button>
                </div>
            </div>
        </details>
            </form>
            <nav class="listing-category-tabs" aria-label="Listing categories">
                <a asp-action="Index"
                   asp-route-Title="@Model.Title"
                   asp-route-City="@Model.City"
                   class="@(!Model.Type.HasValue && !Model.BedroomCount.HasValue ? "is-active" : "")">All listings</a>
                <a asp-action="Index"
                   asp-route-Type="@ListingType.PlaceForRent"
                   asp-route-Title="@Model.Title"
                   asp-route-City="@Model.City"
                   class="@(Model.Type == ListingType.PlaceForRent && !Model.BedroomCount.HasValue ? "is-active" : "")">Places for rent</a>
                <a asp-action="Index"
                   asp-route-Type="@ListingType.LookingForRoommate"
                   asp-route-Title="@Model.Title"
                   asp-route-City="@Model.City"
                   class="@(Model.Type == ListingType.LookingForRoommate ? "is-active" : "")">Roommate listings</a>
                <a asp-action="Index"
                   asp-route-Type="@ListingType.PlaceForRent"
                   asp-route-BedroomCount="0"
                   asp-route-Title="@Model.Title"
                   asp-route-City="@Model.City"
                   class="@(Model.Type == ListingType.PlaceForRent && Model.BedroomCount == 0 ? "is-active" : "")">Studios</a>
            </nav>
        </div>

        <aside class="listing-map-card" aria-label="Map of listings around @mapLocation">
            <iframe src="@googleMapsEmbedUrl"
                    title="Google map of @mapLocation"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            <a href="@googleMapsUrl"
               target="_blank"
               rel="noopener"
               class="listing-map-search">
                Open @mapLocation in Google Maps
            </a>
        </aside>
    </section>

    @if (TempData["SearchMessage"] != null) {
        <div class="alert alert-info" role="status">@TempData["SearchMessage"]</div>
    }

    <div class="listing-results-heading">
        <div>
            <h2>Available listings</h2>
            <p>
                @if (Model.TotalCount == 1) {
                    <span>1 listing found</span>
                }
                else {
                    <span>@Model.TotalCount listings found</span>
                }
                @if (Model.HasActiveFilters) {
                    <span> for your search criteria</span>
                }
            </p>
        </div>
        <div class="listing-results-actions">
        @if (User.Identity?.IsAuthenticated == true && Model.HasActiveFilters) {
            <form asp-controller="SavedSearch" asp-action="Create" method="post" class="listing-save-search">
                @foreach (var item in Model.ToQueryValues()) {
                    <input type="hidden" name="@item.Key" value="@item.Value"/>
                }
                <button type="submit" class="btn-cimerko-light">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
                    Alert me about new matches
                </button>
            </form>
        }
        @if (Model.TotalCount > 1) {
            <form asp-action="Index" method="get" class="listing-sort">
                @foreach (var item in Context.Request.Query.Where(item =>
                              !string.Equals(item.Key, "Sort", StringComparison.OrdinalIgnoreCase) &&
                              !string.Equals(item.Key, "Page", StringComparison.OrdinalIgnoreCase))) {
                    foreach (var value in item.Value) {
                        <input type="hidden" name="@item.Key" value="@value"/>
                    }
                }
                <label for="listingSort">Sort by</label>
                <select id="listingSort" name="Sort" data-auto-submit>
                    @foreach (var option in ListingSort.Options) {
                        <option value="@option.Value" selected="@(option.Value == (Model.Sort ?? ListingSort.Newest))">@option.Label</option>
                    }
                </select>
                <noscript><button type="submit" class="btn-cimerko-light">Sort</button></noscript>
            </form>
        }
        </div>
    </div>

    @if (Model.Listings.Count == 0) {
        <div class="empty-state py-5">
            <svg class="empty-state-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <h3>@(Model.HasActiveFilters ? "No matches this time" : "No listings yet")</h3>
            <p class="text-muted mt-2 mb-4">
                @(Model.HasActiveFilters
                    ? "Try broadening your search or removing a few filters."
                    : "New places for rent and roommate requests will appear here as soon as they are posted.")
            </p>
            @if (Model.HasActiveFilters) {
                <a asp-action="Index" class="btn-cimerko-primary filter-apply-button">Clear filters</a>
            }
        </div>
    }
    else {
        <div class="row g-4 listing-card-grid">
            @foreach (var listing in Model.Listings) {
                var typeLabel = listing.Type.GetDisplayName();
                var primaryImage = listing.Images
                    .OrderByDescending(image => image.IsPrimary)
                    .ThenBy(image => image.CreatedAt)
                    .FirstOrDefault();
                var canSave = currentUserId != null && currentUserId != listing.OwnerId;
                var isSaved = Model.SavedListingIds.Contains(listing.Id);

                <div class="col-12 col-md-6 col-xl-4">
                    <article class="listing-card">
                        <div class="listing-card-img-wrap">
                            @if (canSave) {
                                <form asp-controller="SavedListing"
                                      asp-action="@(isSaved ? "Remove" : "Save")"
                                      method="post"
                                      class="listing-card-save-form"
                                      data-save-url="@saveUrl"
                                      data-remove-url="@removeUrl"
                                      data-listing-title="@listing.Title">
                                    <input type="hidden" name="listingId" value="@listing.Id"/>
                                    <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                    <button type="submit"
                                            class="listing-card-save-btn @(isSaved ? "is-saved" : "")"
                                            aria-label="@(isSaved ? $"Remove {listing.Title} from saved listings" : $"Save {listing.Title}")"
                                            title="@(isSaved ? "Remove from saved listings" : "Save listing")">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.2l7.8-7.8 1.1-1.1a5.5 5.5 0 0 0-.1-7.7z"></path></svg>
                                    </button>
                                </form>
                            }
                            <a asp-action="Details"
                               asp-route-id="@listing.Id"
                               class="listing-card-image-link"
                               aria-label="View @listing.Title">
                                @if (primaryImage != null) {
                                    <img src="@primaryImage.ImageUrl"
                                         alt="@listing.Title"
                                         class="listing-card-img"
                                         loading="lazy"/>
                                } else {
                                    <span class="listing-card-placeholder">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                                        <span>No photo</span>
                                    </span>
                                }
                            </a>
                        </div>
                        <div class="listing-card-content">
                            <div>
                                <h3><a asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></h3>
                                <div class="listing-card-location-new">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <span>@(string.IsNullOrWhiteSpace(listing.Address) ? listing.City : $"{listing.Address} · {listing.City}")</span>
                                </div>
                                <div class="listing-card-reference-price">
                                    <strong>@listing.MonthlyRent.ToString("0") €</strong>
                                    <span>/ month</span>
                                </div>
                                <div class="listing-card-badges">
                                    <span class="badge-soft">@typeLabel</span>
                                    <span class="badge-soft">@listing.RoomCount @(listing.RoomCount == 1 ? "room" : "rooms")</span>
                                    @if (listing.BedroomCount.HasValue) {
                                        <span class="badge-soft">
                                            @(listing.BedroomCount.Value == 0
                                                ? "Studio"
                                                : $"{listing.BedroomCount} {(listing.BedroomCount == 1 ? "bedroom" : "bedrooms")}")
                                        </span>
                                    }
                                    @if (listing.Type == ListingType.LookingForRoommate && listing.RoommatesNeeded.HasValue) {
                                        <span class="badge-soft">@listing.RoommatesNeeded needed</span>
                                    }
                                    @if (listing.Type == ListingType.LookingForRoommate &&
                                         listing.RoommateGenderPreference != RoommateGenderPreference.NoPreference) {
                                        <span class="badge-soft">@listing.RoommateGenderPreference.GetDisplayName() preferred</span>
                                    }
                                    @if (listing.Type == ListingType.LookingForRoommate &&
                                         listing.RoommateHousingPlan.HasValue) {
                                        <span class="badge-soft">@listing.RoommateHousingPlan.Value.GetDisplayName()</span>
                                    }
                                    <span class="badge-soft">@(listing.AvailableFrom?.ToString("dd MMM") ?? "Available now")</span>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
        <partial name="_Pagination" model="Model.Pagination"/>
    }
</div>

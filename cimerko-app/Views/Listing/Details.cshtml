@model cimerko_app.Models.ViewModels.ListingDetailsViewModel

@{
    ViewData["Title"] = Model.Listing.Title;

    var listing = Model.Listing;
    var owner = listing.Owner;
    var ownerProfile = owner?.RoommateProfile;
    var ownerName = string.IsNullOrWhiteSpace(owner?.FullName)
        ? "Cimerko member"
        : owner.FullName;
    var ownerContactEmail = ownerProfile?.ContactEmail;
    var ownerInitial = ownerName.Trim()[..1].ToUpperInvariant();
    var isRental = listing.Type == ListingType.PlaceForRent;
    var listingImages = listing.Images
        .OrderByDescending(image => image.IsPrimary)
        .ThenBy(image => image.CreatedAt)
        .ToList();
    var photoCount = Math.Min(listingImages.Count, 5);
    var typeLabel = listing.Type.GetDisplayName();
    var isAvailableNow = listing.AvailableFrom == null || listing.AvailableFrom.Value.Date <= DateTime.UtcNow.Date;
    var availableLabel = isAvailableNow
        ? "Available now"
        : $"From {listing.AvailableFrom!.Value:d MMM yyyy}";
    var hasExactLocation = !string.IsNullOrWhiteSpace(listing.Address);
    var locationLabel = hasExactLocation
        ? $"{listing.Address}, {listing.City}"
        : listing.City;
    var mapQuery = Uri.EscapeDataString(locationLabel);
    var googleMapsUrl = $"https://www.google.com/maps/search/?api=1&query={mapQuery}";
    var googleMapsEmbedUrl = $"https://www.google.com/maps?q={mapQuery}&z={(hasExactLocation ? 15 : 12)}&output=embed";
    var contactRole = isRental ? "landlord" : "owner";
    var bedroomLabel = listing.BedroomCount == 0
        ? "Studio"
        : $"{listing.BedroomCount} {(listing.BedroomCount == 1 ? "bedroom" : "bedrooms")}";
    var returnUrl = Url.Action("Details", "Listing", new { id = listing.Id });
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var photoGallery = new cimerko_app.Models.ViewModels.ListingPhotoGalleryViewModel {
        DialogId = "listingPhotoViewer",
        Title = listing.Title,
        Images = listingImages
    };

    var rentalRules = new List<(string Icon, string Label, string Value)>();
    if (isRental) {
        rentalRules.Add(("tenant", "Preferred tenant", listing.TenantTypePreference.GetDisplayName()));
        rentalRules.Add(("smoke", "Smoking", listing.RentalSmokingPolicy.GetDisplayName()));
        rentalRules.Add(("pet", "Pets", listing.RentalPetPolicy.GetDisplayName()));
    }

    var roommateTraits = new List<(string Icon, string Label)>();
    if (!isRental) {
        if (listing.RoommateHousingPlan.HasValue) { roommateTraits.Add(("home", listing.RoommateHousingPlan.Value.GetDisplayName())); }
        if (listing.RoommateGenderPreference != RoommateGenderPreference.NoPreference) { roommateTraits.Add(("tenant", $"{listing.RoommateGenderPreference.GetDisplayName()} flatmate preferred")); }
        if (listing.RoommateSmokeFree) { roommateTraits.Add(("smoke", "Smoke-free home")); }
        if (listing.RoommatePetFriendly) { roommateTraits.Add(("pet", "Pet-friendly")); }
        if (listing.RoommateTidy) { roommateTraits.Add(("sparkle", "Tidy shared spaces")); }
        if (listing.RoommateEarlyBird) { roommateTraits.Add(("sun", "Early-bird routine")); }
        if (listing.RoommateNightOwl) { roommateTraits.Add(("moon", "Night-owl routine")); }
        if (listing.RoommateGuestsWelcome) { roommateTraits.Add(("guests", "Guests welcome")); }
    }

    var ownerHabits = new List<(string Label, string Value)>();
    if (!isRental && ownerProfile != null) {
        if (!string.IsNullOrWhiteSpace(ownerProfile.SmokingPreference)) { ownerHabits.Add(("Smoking", ownerProfile.SmokingPreference)); }
        if (!string.IsNullOrWhiteSpace(ownerProfile.PetsPreference)) { ownerHabits.Add(("Pets", ownerProfile.PetsPreference)); }
        if (!string.IsNullOrWhiteSpace(ownerProfile.CleanlinessLevel)) { ownerHabits.Add(("Cleanliness", ownerProfile.CleanlinessLevel)); }
        if (!string.IsNullOrWhiteSpace(ownerProfile.SleepSchedule)) { ownerHabits.Add(("Sleep schedule", ownerProfile.SleepSchedule)); }
        if (!string.IsNullOrWhiteSpace(ownerProfile.GuestPreference)) { ownerHabits.Add(("Guests", ownerProfile.GuestPreference)); }
    }
}

@functions {
    private static string Icon(string name) => name switch {
        "tenant" => "<circle cx=\"12\" cy=\"8\" r=\"3.5\"/><path d=\"M5 20c.5-4 3.2-6 7-6s6.5 2 7 6\"/>",
        "smoke" => "<path d=\"M4 14h13v4H4zM19 14h1v4h-1M8 11c0-2 2-2 2-4M12 11c0-2 2-2 2-4\"/>",
        "pet" => "<circle cx=\"8\" cy=\"8\" r=\"1.6\"/><circle cx=\"16\" cy=\"8\" r=\"1.6\"/><circle cx=\"5.5\" cy=\"12.5\" r=\"1.5\"/><circle cx=\"18.5\" cy=\"12.5\" r=\"1.5\"/><path d=\"M8.5 18.5c0-2.6 1.6-4.5 3.5-4.5s3.5 1.9 3.5 4.5c0 1.2-1.6 1.5-3.5 1.5s-3.5-.3-3.5-1.5Z\"/>",
        "home" => "<path d=\"M4 11.5 12 5l8 6.5V20H4z\"/><path d=\"M9 20v-6h6v6\"/>",
        "sparkle" => "<path d=\"m14 4 1.2 3.3L18.5 8l-3.3 1.2L14 12.5l-1.2-3.3L9.5 8l3.3-.7L14 4ZM6 12l.8 2.2L9 15l-2.2.8L6 18l-.8-2.2L3 15l2.2-.8L6 12Z\"/>",
        "sun" => "<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4\"/>",
        "moon" => "<path d=\"M19 15.5A8 8 0 0 1 8.5 5 8 8 0 1 0 19 15.5Z\"/>",
        "guests" => "<circle cx=\"9\" cy=\"8\" r=\"3\"/><circle cx=\"17\" cy=\"10\" r=\"2\"/><path d=\"M3 19c.4-4 2.4-6 6-6s5.6 2 6 6M15 15c3 0 4.7 1.3 5 4\"/>",
        "rooms" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M12 4v16M3 12h9\"/>",
        "bed" => "<path d=\"M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 15h18M6 9V6h5v3M13 9V6h5v3\"/>",
        "calendar" => "<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M3 10h18\"/>",
        "people" => "<circle cx=\"9\" cy=\"8\" r=\"3\"/><circle cx=\"17\" cy=\"10\" r=\"2\"/><path d=\"M3 19c.4-4 2.4-6 6-6s5.6 2 6 6M15 15c3 0 4.7 1.3 5 4\"/>",
        "pin" => "<path d=\"M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/>",
        _ => ""
    };
}

<div class="page-shell listing-detail-page">
    <a asp-action="Index" class="listing-detail-back">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Listings
    </a>

    @if (TempData["RequestMessage"] != null) {
        <div class="alert alert-success" role="status">@TempData["RequestMessage"]</div>
    }
    @if (TempData["ListingMessage"] != null) {
        <div class="alert alert-info" role="status">@TempData["ListingMessage"]</div>
    }
    @if (TempData["ReportMessage"] != null) {
        <div class="alert alert-info" role="status">@TempData["ReportMessage"]</div>
    }
    @if (Model.IsOwner && listing.ModerationStatus != ListingModerationStatus.Approved) {
        <div class="alert alert-warning" role="status">
            Moderation status: @listing.ModerationStatus.GetDisplayName(). This listing is not visible in public search.
        </div>
    }

    <header class="listing-detail-header">
        <div>
            <span class="listing-detail-type @(isRental ? "is-rental" : "is-roommate")">@typeLabel</span>
            <h1>@listing.Title</h1>
            <p class="listing-detail-meta">
                <a href="@googleMapsUrl" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon("pin"))</svg>
                    @locationLabel
                </a>
                <span>@availableLabel</span>
            </p>
        </div>
        <div class="listing-detail-tools">
            @if (!Model.IsOwner) {
                if (isAuthenticated) {
                    <form asp-controller="SavedListing" asp-action="@(Model.IsSaved ? "Remove" : "Save")" method="post">
                        <input type="hidden" name="listingId" value="@listing.Id"/>
                        <input type="hidden" name="returnTo" value="details"/>
                        <button type="submit" class="listing-detail-tool @(Model.IsSaved ? "is-saved" : "")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.2l7.8-7.8 1.1-1.1a5.5 5.5 0 0 0-.1-7.7z"/></svg>
                            @(Model.IsSaved ? "Saved" : "Save")
                        </button>
                    </form>
                } else {
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl" class="listing-detail-tool">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.2l7.8-7.8 1.1-1.1a5.5 5.5 0 0 0-.1-7.7z"/></svg>
                        Save
                    </a>
                }
            }
            <button type="button" class="listing-detail-tool" data-share-listing>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg>
                <span data-share-label>Share</span>
            </button>
            @if (!Model.IsOwner && isAuthenticated) {
                <a asp-controller="Report" asp-action="Listing" asp-route-id="@listing.Id" class="listing-detail-tool">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4h11l-1 4 1 4H5"/></svg>
                    Report
                </a>
            }
        </div>
    </header>

    @if (photoCount == 0) {
        <div class="listing-detail-photos is-empty">
            <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon("home"))</svg>
            <span>No photos added yet</span>
        </div>
    } else {
        <div class="listing-detail-photos has-@photoCount">
            @for (var index = 0; index < photoCount; index++) {
                var isLast = index == photoCount - 1;
                <button type="button"
                        class="listing-detail-photo"
                        data-gallery-open="listingPhotoViewer"
                        data-gallery-index="@index"
                        aria-label="View photo @(index + 1) of @listingImages.Count">
                    <img src="@listingImages[index].ImageUrl" alt="@listing.Title photo @(index + 1)" loading="@(index == 0 ? "eager" : "lazy")"/>
                    @if ((isLast || index == 0) && listingImages.Count > 1) {
                        <span class="listing-detail-photo-count @(index == 0 ? "is-first" : "")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5L5 21"/></svg>
                            All @listingImages.Count photos
                        </span>
                    }
                </button>
            }
        </div>
    }

    <div class="listing-detail-layout">
        <div class="listing-detail-main">
            <ul class="listing-detail-facts">
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon("rooms"))</svg>
                    <span><strong>@listing.RoomCount</strong> @(listing.RoomCount == 1 ? "room" : "rooms")</span>
                </li>
                @if (listing.BedroomCount.HasValue) {
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon("bed"))</svg>
                        <span>@bedroomLabel</span>
                    </li>
                }
                @if (!isRental && listing.RoommatesNeeded.HasValue) {
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon("people"))</svg>
                        <span><strong>@listing.RoommatesNeeded</strong> @(listing.RoommatesNeeded == 1 ? "roommate" : "roommates") needed</span>
                    </li>
                }
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon("calendar"))</svg>
                    <span>@availableLabel</span>
                </li>
            </ul>

            <section class="listing-detail-section">
                <h2>@(isRental ? "About this place" : "About the room and the flat")</h2>
                <p class="listing-detail-description">@(string.IsNullOrWhiteSpace(listing.Description) ? "No description provided." : listing.Description)</p>
            </section>

            <section class="listing-detail-section">
                <h2>@(isRental ? "House rules" : "Living together")</h2>
                @if (isRental) {
                    <ul class="listing-detail-rules">
                        @foreach (var rule in rentalRules) {
                            <li>
                                <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon(rule.Icon))</svg>
                                <span>
                                    <small>@rule.Label</small>
                                    <strong>@rule.Value</strong>
                                </span>
                            </li>
                        }
                    </ul>
                } else if (roommateTraits.Count == 0 && ownerHabits.Count == 0) {
                    <p class="listing-detail-empty">@ownerName has not shared household preferences for this listing yet.</p>
                } else {
                    @if (roommateTraits.Count > 0) {
                        <ul class="listing-detail-traits">
                            @foreach (var trait in roommateTraits) {
                                <li>
                                    <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon(trait.Icon))</svg>
                                    @trait.Label
                                </li>
                            }
                        </ul>
                    }
                    @if (ownerHabits.Count > 0) {
                        <p class="listing-detail-subheading">How @ownerName lives</p>
                        <dl class="listing-detail-habits">
                            @foreach (var habit in ownerHabits) {
                                <div>
                                    <dt>@habit.Label</dt>
                                    <dd>@habit.Value</dd>
                                </div>
                            }
                        </dl>
                    }
                }
            </section>

            <section class="listing-detail-section">
                <h2>Location</h2>
                <div class="listing-detail-map">
                    <iframe src="@googleMapsEmbedUrl"
                            title="Map of @locationLabel"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
                <div class="listing-detail-address">
                    <div>
                        <strong>@locationLabel</strong>
                        <p>@(hasExactLocation ? "Exact address shared by the owner." : "Only the city is shown until the owner shares the address.")</p>
                    </div>
                    <a href="@googleMapsUrl" target="_blank" rel="noopener" class="btn-cimerko-light">Open in Google Maps</a>
                </div>
            </section>
        </div>

        <aside class="listing-detail-aside" id="contact">
            <div class="listing-detail-card">
                <p class="listing-detail-price">
                    <strong>@listing.MonthlyRent.ToString("0") €</strong>
                    <span>/ month</span>
                </p>

                @if (Model.IsOwner) {
                    <div class="listing-detail-owner-actions">
                        <a asp-action="Edit" asp-route-id="@listing.Id" class="btn-cimerko-primary">Edit listing</a>
                        @if (listing.IsActive) {
                            <form asp-action="MarkTaken" asp-route-id="@listing.Id" method="post">
                                <button type="submit" class="btn-cimerko-light listing-detail-wide">Mark as taken</button>
                            </form>
                        }
                        <a asp-action="Delete" asp-route-id="@listing.Id" class="btn-cimerko-light listing-detail-delete">Delete listing</a>
                    </div>
                } else if (!listing.IsActive) {
                    <div class="listing-detail-notice">This listing is no longer active.</div>
                } else if (isAuthenticated) {
                    if (Model.ExistingRequest != null) {
                        <div class="listing-detail-notice is-@Model.ExistingRequest.Status.ToString().ToLowerInvariant()">
                            Your request is @Model.ExistingRequest.Status.ToString().ToLowerInvariant()
                        </div>
                        @if (Model.ExistingRequest.Status == RequestStatus.Pending) {
                            <form asp-controller="ListingRequest" asp-action="Withdraw" method="post">
                                <input type="hidden" name="id" value="@Model.ExistingRequest.Id"/>
                                <input type="hidden" name="returnTo" value="listing"/>
                                <button type="submit" class="btn-cimerko-light listing-detail-wide">Withdraw request</button>
                            </form>
                        }
                        <a asp-controller="ListingRequest" asp-action="Index" asp-route-view="sent" class="btn-cimerko-light listing-detail-wide">View my requests</a>
                    } else {
                        <form asp-controller="ListingRequest" asp-action="Create" method="post" class="listing-detail-request">
                            <input type="hidden" name="listingId" value="@listing.Id"/>
                            <label for="request-message">Message to the @contactRole</label>
                            <textarea id="request-message"
                                      name="message"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Introduce yourself, say when you would like to move in and ask anything you want to know."
                                      required></textarea>
                            <button type="submit" class="btn-cimerko-primary listing-detail-wide">Send request</button>
                            <small>The @contactRole sees your profile with the request.</small>
                        </form>
                    }
                } else {
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl" class="btn-cimerko-primary listing-detail-wide">
                        Sign in to send a request
                    </a>
                    <small class="listing-detail-hint">Free account, takes a minute.</small>
                }

                <div class="listing-detail-host">
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@listing.OwnerId" class="listing-detail-host-avatar">
                        @if (!string.IsNullOrWhiteSpace(owner?.ProfileImageUrl)) {
                            <img src="@owner.ProfileImageUrl" alt=""/>
                        } else {
                            <span>@ownerInitial</span>
                        }
                    </a>
                    <div class="listing-detail-host-copy">
                        <small>@(isRental ? "Landlord" : "Posted by")</small>
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@listing.OwnerId">@ownerName</a>
                        @if (Model.OwnerReviewCount > 0 && Model.OwnerAverageRating.HasValue) {
                            <span class="listing-detail-rating">
                                <span aria-hidden="true">★</span>
                                @Model.OwnerAverageRating.Value.ToString("0.0")
                                <em>· @Model.OwnerReviewCount @(Model.OwnerReviewCount == 1 ? "review" : "reviews")</em>
                            </span>
                        } else if (owner != null) {
                            <span class="listing-detail-rating"><em>Member since @owner.CreatedAt.ToString("MMM yyyy")</em></span>
                        }
                    </div>
                </div>

                @if (!Model.IsOwner && Model.ExistingRequest?.Status == RequestStatus.Accepted) {
                    <dl class="listing-detail-contact">
                        @if (!string.IsNullOrWhiteSpace(ownerContactEmail)) {
                            <div>
                                <dt>Email</dt>
                                <dd><a href="mailto:@ownerContactEmail">@ownerContactEmail</a></dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(listing.ContactPhone)) {
                            <div>
                                <dt>Phone</dt>
                                <dd><a href="tel:@listing.ContactPhone">@listing.ContactPhone</a></dd>
                            </div>
                        }
                    </dl>
                } else if (!Model.IsOwner && listing.IsActive) {
                    <small class="listing-detail-hint">Contact details are shared once the @contactRole accepts your request.</small>
                }
            </div>
        </aside>
    </div>
</div>

@if (!Model.IsOwner && listing.IsActive) {
    <div class="listing-detail-mobile-bar">
        <p>
            <strong>@listing.MonthlyRent.ToString("0") €</strong>
            <span>/ month</span>
        </p>
        <a href="#contact" class="btn-cimerko-primary">@(isAuthenticated ? "Send request" : "Contact")</a>
    </div>
}

@if (photoCount > 0) {
    <partial name="_ListingPhotoGallery" model="photoGallery"/>
}

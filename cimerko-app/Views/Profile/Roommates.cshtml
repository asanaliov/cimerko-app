@model cimerko_app.Models.ViewModels.RoommateSearchViewModel

@{
    ViewData["Title"] = "Roommates";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@functions {
    private static string Short(IEnumerable<string> labels) => string.Join(", ", labels.Select(label => label switch {
        "Sleep schedule" => "sleep",
        "Guest preference" => "guests",
        _ => label.ToLowerInvariant()
    }));
}

<div class="page-shell roommates-page">
    <header class="roommates-header">
        <div>
            <h1>Find a roommate you will actually get along with</h1>
            <p>Everyone here has an active roommate listing. Compare budgets, routines and house habits before you send a request.</p>
        </div>
        @if (isAuthenticated) {
            <a asp-controller="Listing"
               asp-action="Create"
               asp-route-type="@ListingType.LookingForRoommate"
               class="btn-cimerko-primary">Post a roommate listing</a>
        } else {
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Roommates", "Profile")" class="btn-cimerko-light">
                Sign in to see your match scores
            </a>
        }
    </header>

    <form asp-action="Roommates" method="get" class="roommates-search">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="roommates-search-row">
            <label class="roommates-search-field roommates-search-city">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <span>
                    <small>City</small>
                    <input asp-for="City" placeholder="Anywhere"/>
                </span>
            </label>
            <div class="roommates-search-field roommates-search-budget">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6.5A6.5 6.5 0 0 0 7.5 8.5H15M5 11h9M5 14h9M7.5 15.5A6.5 6.5 0 0 0 18 17.5"/></svg>
                <span>
                    <small>Budget per month</small>
                    <span class="roommates-search-range">
                        <input asp-for="MinimumBudget" type="number" min="0" step="1" placeholder="Min" aria-label="Minimum budget"/>
                        <em>–</em>
                        <input asp-for="MaximumBudget" type="number" min="0" step="1" placeholder="Max" aria-label="Maximum budget"/>
                        <em>€</em>
                    </span>
                </span>
            </div>
            <label class="roommates-search-field">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-4 3.2-6 7-6s6.5 2 7 6"/></svg>
                <span>
                    <small>Gender</small>
                    <select asp-for="Gender">
                        <option value="">Any</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Prefer not to say">Prefer not to say</option>
                    </select>
                </span>
            </label>
            <label class="roommates-search-field">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20H4z"/><path d="M9 20v-6h6v6"/></svg>
                <span>
                    <small>Housing plan</small>
                    <select asp-for="HousingPlan" asp-items="Html.GetEnumSelectList<RoommateHousingPlan>()">
                        <option value="">Any</option>
                    </select>
                </span>
            </label>
            <label class="roommates-search-field">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                <span>
                    <small>Move in by</small>
                    <input asp-for="AvailableBy" type="date"/>
                </span>
            </label>
            <button type="submit" class="btn-search-purple roommates-search-submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                Search
            </button>
        </div>
        <span asp-validation-for="MaximumBudget" class="listing-form-error"></span>

        <div class="filter-chips roommates-search-chips">
            <span>The home should be</span>
            <label><input asp-for="PetFriendly"/><span>Pet-friendly</span></label>
            <label><input asp-for="SmokeFree"/><span>Smoke-free</span></label>
            <label><input asp-for="Tidy"/><span>Tidy</span></label>
            <label><input asp-for="GuestsWelcome"/><span>Guests welcome</span></label>
            <label><input asp-for="EarlyBird"/><span>Early-bird routine</span></label>
            <label><input asp-for="NightOwl"/><span>Night-owl routine</span></label>
            @if (Model.HasActiveFilters) {
                <a asp-action="Roommates" class="roommates-search-clear">Clear all</a>
            }
        </div>
    </form>

    <div class="listing-results-heading roommates-results-heading">
        <h2>@(Model.HasActiveFilters ? "Matching roommates" : "People looking for a roommate")</h2>
        <p>@Model.Results.Count @(Model.Results.Count == 1 ? "person" : "people")</p>
    </div>

    @if (Model.Results.Count == 0) {
        <div class="empty-state">
            <svg class="empty-state-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2"/><path d="M3 19c.4-4 2.4-6 6-6s5.6 2 6 6M15 15c3 0 4.7 1.3 5 4"/></svg>
            <h3>@(Model.HasActiveFilters ? "Nobody matches these filters yet" : "No roommate listings yet")</h3>
            <p class="text-muted mt-2 mb-4">
                @(Model.HasActiveFilters
                    ? "Widen the budget or clear a filter to see more people."
                    : "People appear here as soon as their roommate listing is approved.")
            </p>
            @if (Model.HasActiveFilters) {
                <a asp-action="Roommates" class="btn-cimerko-primary">Clear filters</a>
            }
        </div>
    } else {
        <div class="roommates-grid">
            @for (var index = 0; index < Model.Results.Count; index++) {
                var item = Model.Results[index];
                var user = item.User;
                var profile = user.RoommateProfile;
                var listing = item.Listing;
                var displayName = string.IsNullOrWhiteSpace(user.FullName)
                    ? user.Email ?? "Cimerko member"
                    : user.FullName;
                var initial = displayName.Trim()[..1].ToUpperInvariant();
                var cover = listing.Images
                    .OrderByDescending(image => image.IsPrimary)
                    .ThenBy(image => image.CreatedAt)
                    .FirstOrDefault();
                var education = string.Join(" · ", new[] { profile?.StudyProgram, profile?.University }
                    .Where(value => !string.IsNullOrWhiteSpace(value)));
                var availableLabel = listing.AvailableFrom == null || listing.AvailableFrom.Value.Date <= DateTime.UtcNow.Date
                    ? "available now"
                    : $"from {listing.AvailableFrom.Value:d MMM}";
                var scoreClass = item.CompatibilityScore switch {
                    >= 85 => "is-excellent",
                    >= 70 => "is-good",
                    >= 45 => "is-partial",
                    _ => "is-low"
                };
                var habits = new List<string>();
                if (!string.IsNullOrWhiteSpace(profile?.SmokingPreference)) { habits.Add(profile.SmokingPreference); }
                if (!string.IsNullOrWhiteSpace(profile?.CleanlinessLevel)) { habits.Add(profile.CleanlinessLevel); }
                if (!string.IsNullOrWhiteSpace(profile?.SleepSchedule)) { habits.Add(profile.SleepSchedule); }
                if (!string.IsNullOrWhiteSpace(profile?.PetsPreference)) { habits.Add(profile.PetsPreference); }
                if (!string.IsNullOrWhiteSpace(profile?.GuestPreference)) { habits.Add($"Guests {profile.GuestPreference.ToLowerInvariant()}"); }
                if (listing.RoommateHousingPlan.HasValue) { habits.Add(listing.RoommateHousingPlan.Value.GetDisplayName()); }
                if (listing.RoommateGenderPreference != RoommateGenderPreference.NoPreference) { habits.Add($"{listing.RoommateGenderPreference.GetDisplayName()} flatmate preferred"); }

                <article class="roommate-card">
                    <a asp-controller="Listing" asp-action="Details" asp-route-id="@listing.Id" class="roommate-card-cover" aria-label="View @listing.Title">
                        @if (cover != null) {
                            <img src="@cover.ImageUrl" alt="" loading="lazy"/>
                        } else {
                            <span class="roommate-card-cover-empty">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20H4z"/><path d="M9 20v-6h6v6"/></svg>
                            </span>
                        }
                    </a>

                    <div class="roommate-card-identity">
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@user.Id" class="roommate-card-avatar">
                            @if (!string.IsNullOrWhiteSpace(user.ProfileImageUrl)) {
                                <img src="@user.ProfileImageUrl" alt=""/>
                            } else {
                                <span>@initial</span>
                            }
                        </a>
                        @if (item.CompatibilityScore.HasValue) {
                            <div class="roommate-card-score @scoreClass" style="--score: @item.CompatibilityScore" title="Compatibility based on your shared preferences">
                                <strong>@item.CompatibilityScore%</strong>
                                <span>@(index == 0 ? "top match" : "match")</span>
                            </div>
                        }
                    </div>

                    <div class="roommate-card-body">
                        <h3>
                            <a asp-controller="Profile" asp-action="Details" asp-route-id="@user.Id">@displayName</a>@if (profile?.Age > 0) {<span>, @profile.Age</span>}
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(education)) {
                            <p class="roommate-card-education">@education</p>
                        }
                        <p class="roommate-card-offer">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                            @listing.City
                            <strong>@listing.MonthlyRent.ToString("0") € / month</strong>
                            <span>@availableLabel</span>
                        </p>

                        @if (!string.IsNullOrWhiteSpace(profile?.Bio)) {
                            <p class="roommate-card-bio">@profile.Bio</p>
                        }

                        @if (habits.Count > 0) {
                            <ul class="roommate-card-habits">
                                @foreach (var habit in habits.Take(5)) {
                                    <li>@habit</li>
                                }
                            </ul>
                        }

                        @if (item.StrongMatches.Count > 0 || item.PossibleConflicts.Count > 0) {
                            <ul class="roommate-card-compat">
                                @if (item.StrongMatches.Count > 0) {
                                    <li class="is-match">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>
                                        You agree on @Short(item.StrongMatches)
                                    </li>
                                }
                                @if (item.PossibleConflicts.Count > 0) {
                                    <li class="is-conflict">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/></svg>
                                        Talk about @Short(item.PossibleConflicts)
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <footer class="roommate-card-footer">
                        <a asp-controller="Listing" asp-action="Details" asp-route-id="@listing.Id" class="roommate-card-listing">
                            <span>@listing.Title</span>
                        </a>
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@user.Id" class="btn-cimerko-light">Profile</a>
                    </footer>
                </article>
            }
        </div>
    }
</div>

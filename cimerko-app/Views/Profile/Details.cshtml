@using cimerko_app.Models.ViewModels
@model ApplicationUser

@{
    ViewData["Title"] = "Profile";
    var currentUserId = ViewBag.CurrentUserId as string;
    var isOwnProfile = ViewBag.IsOwnProfile is bool ownProfile && ownProfile;
    var profile = Model.RoommateProfile;
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? Model.Email ?? "Cimerko member" : Model.FullName;
    var firstName = displayName.Trim().Split(' ')[0];
    var initial = displayName.Trim()[..1].ToUpperInvariant();
    var reviews = Model.ReviewsReceived.OrderByDescending(review => review.CreatedAt).ToList();
    var averageRating = reviews.Count == 0 ? 0 : reviews.Average(review => review.Rating);
    var canWriteReview = ViewBag.CanWriteReview == true;
    var showCompatibility = ViewBag.ShowCompatibility == true;
    var compatibilityScore = ViewBag.CompatibilityScore as int?;
    var compatibilityLabel = compatibilityScore switch {
        >= 85 => "Excellent match",
        >= 70 => "Good match",
        >= 45 => "Partial match",
        _ => "Low match"
    };
    var compatibilityClass = compatibilityScore switch {
        >= 85 => "is-excellent",
        >= 70 => "is-good",
        >= 45 => "is-partial",
        _ => "is-low"
    };
    var comparedPreferences = ViewBag.ComparedPreferences is int preferenceCount ? preferenceCount : 0;
    var compatibilityStrongMatches =
        ViewBag.CompatibilityStrongMatches as IReadOnlyList<string> ?? Array.Empty<string>();
    var compatibilityPossibleConflicts =
        ViewBag.CompatibilityPossibleConflicts as IReadOnlyList<string> ?? Array.Empty<string>();
    var profileBadges =
        ViewBag.ProfileBadges as IReadOnlyList<ProfileBadgeViewModel> ?? Array.Empty<ProfileBadgeViewModel>();
    var profileCompletion = ViewBag.ProfileCompletion as ProfileCompletionViewModel;
    var showSidebar = showCompatibility || reviews.Count > 0 || canWriteReview;
    var profileListings = Model.Listings
        .OrderByDescending(listing => listing.CreatedAt)
        .ToList();
    var activeListingCount = profileListings.Count(listing =>
        listing.IsActive && listing.ModerationStatus == ListingModerationStatus.Approved);
    var pendingListingCount = profileListings.Count(listing =>
        listing.ModerationStatus == ListingModerationStatus.Pending);
    var education = string.Join(" · ", new[] { profile?.StudyProgram, profile?.University }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    var preferences = new (string Icon, string Label, string? Value)[] {
        ("smoke", "Smoking", profile?.SmokingPreference),
        ("pet", "Pets", profile?.PetsPreference),
        ("sparkle", "Cleanliness", profile?.CleanlinessLevel),
        ("moon", "Sleep", profile?.SleepSchedule),
        ("guests", "Guests", profile?.GuestPreference)
    };
    var hasLivingPreferences = preferences.Any(preference => !string.IsNullOrWhiteSpace(preference.Value));
}

@functions {
    private static string Icon(string name) => name switch {
        "smoke" => "<path d=\"M4 14h13v4H4zM19 14h1v4h-1M8 11c0-2 2-2 2-4M12 11c0-2 2-2 2-4\"/>",
        "pet" => "<circle cx=\"8\" cy=\"8\" r=\"1.6\"/><circle cx=\"16\" cy=\"8\" r=\"1.6\"/><circle cx=\"5.5\" cy=\"12.5\" r=\"1.5\"/><circle cx=\"18.5\" cy=\"12.5\" r=\"1.5\"/><path d=\"M8.5 18.5c0-2.6 1.6-4.5 3.5-4.5s3.5 1.9 3.5 4.5c0 1.2-1.6 1.5-3.5 1.5s-3.5-.3-3.5-1.5Z\"/>",
        "sparkle" => "<path d=\"m14 4 1.2 3.3L18.5 8l-3.3 1.2L14 12.5l-1.2-3.3L9.5 8l3.3-.7L14 4ZM6 12l.8 2.2L9 15l-2.2.8L6 18l-.8-2.2L3 15l2.2-.8L6 12Z\"/>",
        "moon" => "<path d=\"M19 15.5A8 8 0 0 1 8.5 5 8 8 0 1 0 19 15.5Z\"/>",
        "guests" => "<circle cx=\"9\" cy=\"8\" r=\"3\"/><circle cx=\"17\" cy=\"10\" r=\"2\"/><path d=\"M3 19c.4-4 2.4-6 6-6s5.6 2 6 6M15 15c3 0 4.7 1.3 5 4\"/>",
        _ => ""
    };
}

<div class="profile-details-shell">
    @if (TempData["ReviewMessage"] != null) {
        <div class="alert alert-info profile-details-alert" role="status">@TempData["ReviewMessage"]</div>
    }
    @if (TempData["ReportMessage"] != null) {
        <div class="alert alert-info profile-details-alert" role="status">@TempData["ReportMessage"]</div>
    }

    <section class="profile-hero">
        <div class="profile-hero-accent" aria-hidden="true"></div>
        <div class="profile-hero-content">
            <div class="profile-hero-avatar" aria-label="@displayName profile picture">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl)) {
                    <img src="@Model.ProfileImageUrl" alt="@displayName"/>
                }
                else {
                    <span aria-hidden="true">@initial</span>
                }
            </div>

            <div class="profile-hero-identity">
                <h1>@displayName</h1>
                <p class="profile-hero-meta">
                    @if (!string.IsNullOrWhiteSpace(profile?.City)) {
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                            @profile.City
                        </span>
                    }
                    @if (profile?.Age > 0) {
                        <span>@profile.Age years old</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(education)) {
                        <span>@education</span>
                    }
                </p>
                @if (profileBadges.Count > 0) {
                    <div class="profile-badges" aria-label="Profile badges">
                        @foreach (var badge in profileBadges) {
                            <span class="profile-badge @badge.CssClass">@badge.Text</span>
                        }
                    </div>
                }
            </div>

            <div class="profile-hero-actions">
                @if (isOwnProfile) {
                    <a asp-action="Edit" class="btn-cimerko-primary">Edit profile</a>
                    <a asp-area="Identity"
                       asp-page="/Account/Manage/Index"
                       class="profile-settings-button"
                       aria-label="Manage account"
                       title="Manage account">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/>
                        </svg>
                    </a>
                }
                else if (User.Identity?.IsAuthenticated == true) {
                    @if (activeListingCount > 0) {
                        <a href="#profile-listings" class="btn-cimerko-primary">See @(activeListingCount == 1 ? "listing" : "listings")</a>
                    }
                    <a asp-controller="Report"
                       asp-action="UserProfile"
                       asp-route-id="@Model.Id"
                       class="btn-cimerko-light">Report</a>
                }
            </div>
        </div>

        <dl class="profile-hero-stats">
            <div>
                <dt>Rating</dt>
                <dd>
                    @if (reviews.Count > 0) {
                        <span class="profile-hero-star" aria-hidden="true">★</span>@averageRating.ToString("0.0")
                        <small>@(reviews.Count == 1 ? "1 review" : $"{reviews.Count} reviews")</small>
                    } else {
                        <span>No reviews yet</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Listings</dt>
                <dd>
                    @activeListingCount active
                    @if (isOwnProfile && pendingListingCount > 0) {
                        <small>@pendingListingCount pending</small>
                    }
                </dd>
            </div>
            <div>
                <dt>Member since</dt>
                <dd>@Model.CreatedAt.ToString("MMMM yyyy")</dd>
            </div>
        </dl>
    </section>

    @if (isOwnProfile && profileCompletion != null && !profileCompletion.IsProfileComplete) {
        <section class="profile-completion">
            <div class="profile-completion-heading">
                <strong>Your profile is @profileCompletion.ProfileCompletionPercentage% complete</strong>
                <span>Complete profiles get better roommate matches.</span>
            </div>
            <div class="profile-completion-track"
                 role="progressbar"
                 aria-label="Profile completion"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@profileCompletion.ProfileCompletionPercentage">
                <span style="width: @(profileCompletion.ProfileCompletionPercentage)%"></span>
            </div>
            <ul class="profile-missing-list">
                @foreach (var field in profileCompletion.MissingProfileFields) {
                    <li><a asp-action="Edit" asp-fragment="@field.EditAnchor">+ @field.Name</a></li>
                }
            </ul>
        </section>
    }

    <div class="profile-details-grid @(!showSidebar ? "profile-details-grid-single" : "")">
        <main class="profile-details-main">
            <section class="profile-content-card">
                <h2>About @firstName</h2>

                @if (profile == null) {
                    <div class="profile-empty-state">
                        <h3>@(isOwnProfile ? "Complete your profile" : "No profile details yet")</h3>
                        <p>
                            @(isOwnProfile
                                ? "Add a short introduction and your living habits so roommates can find you."
                                : "This member has not filled in their roommate profile yet.")
                        </p>
                        @if (isOwnProfile) {
                            <a asp-action="Edit" class="btn-cimerko-light">Complete profile</a>
                        }
                    </div>
                }
                else {
                    <p class="profile-bio">
                        @(string.IsNullOrWhiteSpace(profile.Bio)
                            ? isOwnProfile
                                ? "Add an introduction to help potential roommates get to know you."
                                : $"{firstName} has not written an introduction yet."
                            : profile.Bio)
                    </p>

                    <dl class="profile-facts">
                        <div>
                            <dt>City</dt>
                            <dd>@profile.City</dd>
                        </div>
                        <div>
                            <dt>Age</dt>
                            <dd>@(profile.Age?.ToString() ?? "Not specified")</dd>
                        </div>
                        <div>
                            <dt>Gender</dt>
                            <dd>@(profile.Gender ?? "Not specified")</dd>
                        </div>
                        <div>
                            <dt>University</dt>
                            <dd>@(profile.University ?? "Not specified")</dd>
                        </div>
                        <div>
                            <dt>Faculty</dt>
                            <dd>@(profile.StudyProgram ?? "Not specified")</dd>
                        </div>
                        @if ((!string.IsNullOrWhiteSpace(profile.ContactEmail) && ViewBag.CanSeeContact == true) || isOwnProfile) {
                            <div>
                                <dt>Contact email</dt>
                                <dd>
                                    @if (!string.IsNullOrWhiteSpace(profile.ContactEmail)) {
                                        <a href="mailto:@profile.ContactEmail">@profile.ContactEmail</a>
                                    }
                                    else {
                                        <span>Not specified</span>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                }
            </section>

            <section class="profile-content-card">
                <h2>Living habits</h2>

                @if (profile == null || !hasLivingPreferences) {
                    <div class="profile-empty-state">
                        <h3>@(isOwnProfile ? "Add your living habits" : "No living habits shared yet")</h3>
                        <p>
                            @(isOwnProfile
                                ? "Smoking, pets, cleanliness, sleep and guests are what compatibility scores are based on."
                                : $"{firstName} has not shared household preferences yet.")
                        </p>
                        @if (isOwnProfile) {
                            <a asp-action="Edit" asp-fragment="SmokingPreference" class="btn-cimerko-light">Add habits</a>
                        }
                    </div>
                }
                else {
                    <ul class="profile-preference-grid">
                        @foreach (var preference in preferences) {
                            <li class="@(string.IsNullOrWhiteSpace(preference.Value) ? "is-empty" : "")">
                                <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(Icon(preference.Icon))</svg>
                                <small>@preference.Label</small>
                                <strong>@(preference.Value ?? "Not specified")</strong>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="profile-listings-section" id="profile-listings">
                <div class="profile-section-title">
                    <h2>@(isOwnProfile ? "Your listings" : $"{firstName}'s listings")</h2>
                    @if (profileListings.Count > 0) {
                        <span class="profile-section-count">
                            @(isOwnProfile && pendingListingCount > 0
                                ? $"{pendingListingCount} pending"
                                : $"{profileListings.Count} {(isOwnProfile ? "total" : "active")}")
                        </span>
                    }
                </div>

                @if (profileListings.Count == 0) {
                    <div class="profile-empty-state">
                        <h3>@(isOwnProfile ? "No listings yet" : "No active listings")</h3>
                        <p>
                            @(isOwnProfile
                                ? "Post a place for rent or a roommate request and it will show up here."
                                : $"{firstName} has no active listings right now.")
                        </p>
                        @if (isOwnProfile) {
                            <a asp-controller="Listing" asp-action="Create" class="btn-cimerko-light">Post a listing</a>
                        }
                    </div>
                }
                else {
                    <div class="profile-listing-grid">
                        @foreach (var listing in profileListings) {
                            var cover = listing.Images
                                .OrderByDescending(image => image.IsPrimary)
                                .ThenBy(image => image.CreatedAt)
                                .FirstOrDefault();
                            var listingStatusHelp = listing.ModerationStatus switch {
                                ListingModerationStatus.Pending => "Waiting for admin approval.",
                                ListingModerationStatus.Approved when listing.IsActive => "Visible in public search.",
                                ListingModerationStatus.Approved => "Approved but not active.",
                                ListingModerationStatus.Rejected => "Rejected, not visible.",
                                ListingModerationStatus.Inactive => "Hidden from public search.",
                                _ => "Status unavailable."
                            };

                            <article class="profile-listing-card">
                                <a asp-controller="Listing" asp-action="Details" asp-route-id="@listing.Id" class="profile-listing-cover" aria-label="View @listing.Title">
                                    @if (cover != null) {
                                        <img src="@cover.ImageUrl" alt="" loading="lazy"/>
                                    } else {
                                        <span class="profile-listing-cover-empty">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20H4z"/><path d="M9 20v-6h6v6"/></svg>
                                        </span>
                                    }
                                    <span class="profile-listing-type @(listing.Type == ListingType.PlaceForRent ? "is-place" : "is-roommate")">
                                        @listing.Type.GetDisplayName()
                                    </span>
                                </a>
                                <div class="profile-listing-body">
                                    <h3><a asp-controller="Listing" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></h3>
                                    <p>
                                        @listing.City · @listing.RoomCount @(listing.RoomCount == 1 ? "room" : "rooms")
                                        @if (listing.BedroomCount.HasValue) {
                                            <span>
                                                · @(listing.BedroomCount.Value == 0
                                                    ? "studio"
                                                    : $"{listing.BedroomCount} {(listing.BedroomCount == 1 ? "bedroom" : "bedrooms")}")
                                            </span>
                                        }
                                    </p>
                                    <div class="profile-listing-footer">
                                        <strong>@listing.MonthlyRent.ToString("0") € <small>/ month</small></strong>
                                        @if (isOwnProfile) {
                                            <span class="admin-status is-@listing.ModerationStatus.ToString().ToLowerInvariant()" title="@listingStatusHelp">
                                                @listing.ModerationStatus.GetDisplayName()
                                            </span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="profile-reviews-section">
                <div class="profile-section-title">
                    <h2>Reviews</h2>
                    @if (reviews.Count > 0) {
                        <span class="profile-section-count">★ @averageRating.ToString("0.0") · @reviews.Count</span>
                    }
                </div>

                @if (reviews.Count == 0) {
                    <div class="profile-empty-state">
                        <h3>No reviews yet</h3>
                        <p>
                            @(isOwnProfile
                                ? "Reviews appear after someone you connected with through a request writes one."
                                : $"Nobody has reviewed {firstName} yet. Reviews come from people connected through an accepted request.")
                        </p>
                    </div>
                }
                else {
                    <div class="profile-review-list">
                        @foreach (var review in reviews) {
                            var reviewerName = string.IsNullOrWhiteSpace(review.Reviewer?.FullName)
                                ? review.Reviewer?.Email ?? "Cimerko member"
                                : review.Reviewer.FullName;
                            var reviewerInitial = reviewerName.Trim()[..1].ToUpperInvariant();
                            var breakdown = new (string Label, int? Value)[] {
                                ("Smoking", review.SmokingRating),
                                ("Pets", review.PetsRating),
                                ("Cleanliness", review.CleanlinessRating),
                                ("Sleep", review.SleepScheduleRating),
                                ("Guests", review.GuestPreferenceRating)
                            };

                            <article class="profile-review-card">
                                <header class="profile-review-header">
                                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@review.ReviewerId"
                                       class="profile-reviewer">
                                        <span class="profile-reviewer-avatar">
                                            @if (!string.IsNullOrWhiteSpace(review.Reviewer?.ProfileImageUrl)) {
                                                <img src="@review.Reviewer.ProfileImageUrl" alt=""/>
                                            }
                                            else {
                                                <span aria-hidden="true">@reviewerInitial</span>
                                            }
                                        </span>
                                        <span>
                                            <strong>@reviewerName</strong>
                                            <small>@review.CreatedAt.ToString("d MMM yyyy")</small>
                                        </span>
                                    </a>
                                    <div class="profile-review-stars" aria-label="@review.Rating out of 5 stars">
                                        @for (var star = 1; star <= 5; star++) {
                                            <span class="@(star <= review.Rating ? "is-filled" : "")">★</span>
                                        }
                                    </div>
                                </header>

                                @if (!string.IsNullOrWhiteSpace(review.Comment)) {
                                    <p>@review.Comment</p>
                                }

                                @if (breakdown.Any(item => item.Value.HasValue)) {
                                    <ul class="profile-review-breakdown">
                                        @foreach (var item in breakdown.Where(item => item.Value.HasValue)) {
                                            <li><span>@item.Label</span><strong>@item.Value/5</strong></li>
                                        }
                                    </ul>
                                }

                                @if (currentUserId == review.ReviewerId) {
                                    <form asp-controller="Review" asp-action="Delete" method="post"
                                          class="profile-review-delete">
                                        <input type="hidden" name="id" value="@review.Id"/>
                                        <button type="submit">Delete my review</button>
                                    </form>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </main>

        @if (showSidebar) {
            <aside class="profile-details-sidebar">
                @if (showCompatibility) {
                    <section class="profile-compatibility-card">
                        @if (compatibilityScore.HasValue) {
                            <header class="profile-compatibility-header">
                                <div class="profile-compatibility-score @compatibilityClass" style="--score: @compatibilityScore">
                                    <strong>@compatibilityScore%</strong>
                                </div>
                                <div>
                                    <h2>@compatibilityLabel</h2>
                                    <p>
                                        Based on @comparedPreferences shared
                                        @(comparedPreferences == 1 ? "preference" : "preferences") between you and @firstName.
                                    </p>
                                </div>
                            </header>
                            <div class="profile-compatibility-body">
                                @if (compatibilityStrongMatches.Count > 0) {
                                    <div>
                                        <h3>You agree on</h3>
                                        <ul class="profile-match-list">
                                            @foreach (var match in compatibilityStrongMatches) {
                                                <li>@match</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (compatibilityPossibleConflicts.Count > 0) {
                                    <div>
                                        <h3>Worth talking about</h3>
                                        <ul class="profile-conflict-list">
                                            @foreach (var conflict in compatibilityPossibleConflicts) {
                                                <li>@conflict</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                <small>Smoking and cleanliness weigh the most.</small>
                            </div>
                        }
                        else {
                            <div class="profile-compatibility-empty">
                                <h2>Compatibility unavailable</h2>
                                <p>Fill in your own living habits and @firstName's to see a match score.</p>
                                <a asp-action="Edit" asp-fragment="SmokingPreference">Update my habits</a>
                            </div>
                        }
                    </section>
                }

                @if (reviews.Count > 0) {
                    <section class="profile-review-summary-card">
                        <div class="profile-review-score">
                            <strong>@averageRating.ToString("0.0")</strong>
                            <div class="profile-review-summary-stars" aria-label="Average rating">
                                @for (var star = 1; star <= 5; star++) {
                                    <span class="@(star <= Math.Round(averageRating) ? "is-filled" : "")">★</span>
                                }
                            </div>
                        </div>
                        <p>@reviews.Count @(reviews.Count == 1 ? "review" : "reviews") from people who connected with @firstName through Cimerko.</p>
                    </section>
                }

                @if (canWriteReview) {
                    <section class="profile-review-form-card">
                        <h2>Review @firstName</h2>
                        <p>You connected through an accepted request, so you can leave one review.</p>

                        <form asp-controller="Review" asp-action="Create" method="post">
                            <input type="hidden" name="reviewedUserId" value="@Model.Id"/>

                            <label for="rating">Overall</label>
                            <select id="rating" name="rating" class="form-select">
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Very good</option>
                                <option value="3">3 - Good</option>
                                <option value="2">2 - Fair</option>
                                <option value="1">1 - Poor</option>
                            </select>

                            @foreach (var (id, label) in new[] {
                                ("smokingRating", "Smoking habits"),
                                ("petsRating", "Pet responsibility"),
                                ("cleanlinessRating", "Cleanliness"),
                                ("sleepScheduleRating", "Sleep schedule"),
                                ("guestPreferenceRating", "Guest habits")
                            }) {
                                <label for="@id">@label</label>
                                <select id="@id" name="@id" class="form-select" required>
                                    <option value="">Choose a rating</option>
                                    <option value="5">5 - Excellent</option>
                                    <option value="4">4 - Very good</option>
                                    <option value="3">3 - Good</option>
                                    <option value="2">2 - Fair</option>
                                    <option value="1">1 - Poor</option>
                                </select>
                            }

                            <label for="comment">Comment</label>
                            <textarea id="comment" name="comment" class="form-control" rows="4" maxlength="1000"
                                      placeholder="What was it like living or dealing with @firstName?"></textarea>

                            <button type="submit" class="btn-cimerko-primary w-100">Publish review</button>
                        </form>
                    </section>
                }
            </aside>
        }
    </div>
</div>
